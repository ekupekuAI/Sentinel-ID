# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Server-only. Supabase → Project Settings → API → service_role / secret key.
# Required to record identity analyses (users can no longer call that RPC directly).
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional: AI explanations. https://aistudio.google.com/app/apikey
# Without it a deterministic explanation is used.
GEMINI_API_KEY=your-server-only-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Optional: only for compiling/deploying the SecureChainAudit contract (npm run contract:deploy:amoy).
# RPC: https://dashboard.alchemy.com (Polygon Amoy). Use a throwaway test wallet key.
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-api-key
PRIVATE_KEY=your-deployment-or-service-wallet-private-key
CONTRACT_ADDRESS=your-deployed-secure-chain-audit-contract-address
POLYGON_AMOY_CHAIN_ID=80002
